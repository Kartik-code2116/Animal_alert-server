# ==========================================
# WildTrack Microservices .gitignore
# ==========================================

# ------------------------------------------
# 1. Frontend (React / Vite)
# ------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.*
frontend/.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------
# 2. Backend (Python Flask)
# ------------------------------------------
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/.env
backend/venv/
backend/env/
backend/.venv/

# ------------------------------------------
# 3. ML Service (YOLO / PyTorch)
# ------------------------------------------
ml_service/__pycache__/
ml_service/*.py[cod]
ml_service/.env
ml_service/venv/
ml_service/env/
ml_service/.venv/

# Ignore very large models if you download them on AWS instead of pushing via Git
# (Uncomment below if you don't want to push models to GitHub)
# ml_service/*.pt
# ml_service/*.onnx

# ------------------------------------------
# General / OS / IDE
# ------------------------------------------
.DS_Store
.vscode/
.idea/
*.log
*.sqlite3
*.swp
